{% extends "Templates/default.twig" %}

{% block title %}{{ title }} · Efemér{% endblock %}

{% block bodyClass %}site--ritualy{% endblock %}

{% block body %}

	<div class="ritualy">
		<section class="home-hero home-hero--text ritualy__intro" data-reveal>
			<div class="home-hero__text">
				<div class="home-hero__copy">
					<span class="home-hero__kicker">rituály</span>
					<h1 class="home-hero__title">{{ title }}</h1>
					<p class="home-hero__summary">{{ lead }}</p>
					{% if blurb %}
						<p class="ritualy__blurb">{{ blurb }}</p>
					{% endif %}
					<a class="home-hero__cta" href="{{ url("site.kontakt") }}">Napsat o rituálu</a>
				</div>
			</div>
		</section>

		<div class="ritualy__plots">
			{% for post in posts %}
				<article class="home-plot home-plot--{{ loop.index }}" data-reveal>
					{% set image = post.getPreferredImage("landscape") %}
					{% if image %}
						<a class="home-print home-plot__photo" href="{{ post.getPublicUrl }}">
							<span class="home-print__photo">
								<img src="{{ image.getImageVersion("GALLERY").getURL }}" alt="">
							</span>
						</a>
					{% endif %}
					<div class="home-plot__copy">
						{% if post.getPublishedAt %}
							<p class="home-plot__kicker">{{ post.getPublishedAt|date("Y") }}</p>
						{% endif %}
						<h2 class="home-plot__title"><a href="{{ post.getPublicUrl }}">{{ post.getTitle }}</a></h2>
						{% if post.getSummary %}
							<p class="home-plot__lead">{{ post.getSummary }}</p>
						{% endif %}
					</div>
				</article>
			{% else %}
				<p class="ritualy__empty">Zatím tu nic není.</p>
			{% endfor %}
		</div>
	</div>

{% endblock body %}
