{% extends "Templates/default.twig" %}

{% block title %}{{ title }} · Efemér{% endblock %}

{% block bodyClass %}site--denik{% endblock %}

{% block body %}

	<div class="denik">
		<header class="denik__intro">
			<p class="text-eyebrow">{{ title|lower }}</p>
			<h1 class="denik__heading">{{ title }}</h1>
			<p class="denik__lead">{{ lead }}</p>
		</header>

		<div
			class="denik__feed"
			data-feed
			{% if hasMore %}data-feed-next="{{ url("sections.denik") }}?page={{ nextPage }}&amp;partial=1"{% endif %}
		>
			{% for post in posts %}
				{% include "Sections/denik-item.twig" %}
			{% else %}
				<p class="denik__empty">Zatím tu nic není.</p>
			{% endfor %}
			{% include "Partials/feed-ritualy-banner-slot.twig" %}
			{% if hasMore %}
				<div class="feed-sentinel" data-feed-sentinel aria-hidden="true"></div>
			{% endif %}
		</div>
	</div>

{% endblock body %}
