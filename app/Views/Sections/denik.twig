{% extends "Templates/default.twig" %}

{% block title %}{{ title }} · Efemér{% endblock %}

{% block bodyClass %}site--denik{% endblock %}

{% block body %}

	<div class="denik">
		<header class="denik__intro">
			<p class="text-eyebrow">{{ title|lower }}</p>
			<h1 class="denik__heading">{{ title }}</h1>
			<p class="denik__lead">{{ lead }}</p>
		</header>

		<div class="denik__feed">
			{% for post in posts %}
				<article class="denik-feed__item" id="post-{{ post.getId }}">
					<div class="post-article denik-feed__article">
						{% include "Posts/body.twig" with {
							post: post,
							linkedTitle: true,
							showSectionEyebrow: false,
							headingTag: "h2",
						} %}
					</div>
				</article>
			{% else %}
				<p class="denik__empty">Zatím tu nic není.</p>
			{% endfor %}
		</div>
	</div>

{% endblock body %}
