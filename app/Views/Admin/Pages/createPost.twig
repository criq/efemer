{% extends "Templates/admin.twig" %}

{% block title %}Nový příspěvek{% endblock %}

{% block body %}

	<div class="admin-page">
		<div class="admin-page__header">
			<h1 class="admin-page__title">Nový příspěvek</h1>
			<div class="admin-page__actions">
				<a class="admin-button admin-button--ghost" href="{{ url("admin.pages.index") }}">{% include "Blocks/adminIcon.twig" with { name: "arrow_back" } %} Zpět</a>
			</div>
		</div>

		<form class="admin-form" action="" method="POST" enctype="multipart/form-data">
			{% include "Blocks/formHeader.twig" %}
			{% include "Blocks/formErrors.twig" %}

			<section class="admin-section">
				<div class="admin-panel">
					<label class="admin-field">
						<span class="admin-field__label">Název</span>
						<input type="text" name="title" value="{{ title }}" placeholder="Např. Svatba na Bílé hoře" autofocus required>
					</label>
					<label class="admin-field">
						<span class="admin-field__label">Datum</span>
						<input type="date" name="date" value="{{ date }}" required>
					</label>
					<label class="admin-field">
						<span class="admin-field__label">Úvodní fotka (volitelné)</span>
						<input type="file" name="hero" accept="image/*">
					</label>
				</div>
			</section>

			<div class="admin-page__actions">
				<button class="admin-button" type="submit">{% include "Blocks/adminIcon.twig" with { name: "add" } %} Vytvořit příspěvek</button>
			</div>
		</form>
	</div>

{% endblock body %}
