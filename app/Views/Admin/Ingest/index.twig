{% extends "Templates/admin.twig" %}

{% block title %}Import{% endblock %}

{% block body %}

	{% set fq = filterQuery ? filterQuery ~ "&" : "" %}

	<div class="admin-page admin-page--wide">
		<div class="admin-page__header">
			<h1 class="admin-page__title">Import</h1>
			<div class="admin-page__actions">
				<a class="admin-button admin-button--ghost{% if not sourceFilter and not accountFilter %} is-active{% endif %}" href="{{ url("admin.ingest.index") }}{% if statusFilter or kindFilter or q %}?{% endif %}{% if statusFilter %}status={{ statusFilter }}{% endif %}{% if kindFilter %}{% if statusFilter %}&{% endif %}kind={{ kindFilter|url_encode }}{% endif %}{% if q %}{% if statusFilter or kindFilter %}&{% endif %}q={{ q|url_encode }}{% endif %}">Vše</a>
				<a class="admin-button admin-button--ghost{% if sourceFilter == "efemer_cz" %} is-active{% endif %}" href="{{ url("admin.ingest.index") }}?source=efemer_cz{% if statusFilter %}&status={{ statusFilter }}{% endif %}{% if kindFilter %}&kind={{ kindFilter|url_encode }}{% endif %}{% if q %}&q={{ q|url_encode }}{% endif %}">efemer.cz</a>
				<a class="admin-button admin-button--ghost{% if accountFilter == "efemer_flowers" %} is-active{% endif %}" href="{{ url("admin.ingest.index") }}?account=efemer_flowers{% if statusFilter %}&status={{ statusFilter }}{% endif %}{% if kindFilter %}&kind={{ kindFilter|url_encode }}{% endif %}{% if q %}&q={{ q|url_encode }}{% endif %}">@efemer_flowers</a>
				<a class="admin-button admin-button--ghost{% if accountFilter == "himmlhaus" %} is-active{% endif %}" href="{{ url("admin.ingest.index") }}?account=himmlhaus{% if statusFilter %}&status={{ statusFilter }}{% endif %}{% if kindFilter %}&kind={{ kindFilter|url_encode }}{% endif %}{% if q %}&q={{ q|url_encode }}{% endif %}">@himmlhaus</a>
			</div>
		</div>

		<form class="admin-ingest-search" method="get" action="{{ url("admin.ingest.index") }}">
			{% if sourceFilter %}<input type="hidden" name="source" value="{{ sourceFilter }}">{% endif %}
			{% if statusFilter %}<input type="hidden" name="status" value="{{ statusFilter }}">{% endif %}
			{% if accountFilter %}<input type="hidden" name="account" value="{{ accountFilter }}">{% endif %}
			{% if kindFilter %}<input type="hidden" name="kind" value="{{ kindFilter }}">{% endif %}
			<label>
				<span class="admin-muted">Hledat</span>
				<input type="search" name="q" value="{{ q }}" placeholder="název, keyword, entita…">
			</label>
			<button class="admin-button" type="submit">Hledat</button>
		</form>

		<section class="admin-section">
			<h2 class="admin-section__title">Pipeline</h2>
			<div class="admin-panel admin-ingest-pipeline">
				<ol class="admin-ingest-pipeline__stages">
					{% for stage in pipeline.stages %}
						<li class="admin-ingest-pipeline__stage{% if statusFilter == stage.code %} is-active{% endif %}{% if stage.count == 0 %} is-empty{% endif %}">
							<a href="{{ url("admin.ingest.index") }}?status={{ stage.code }}{% if sourceFilter %}&source={{ sourceFilter }}{% endif %}{% if accountFilter %}&account={{ accountFilter }}{% endif %}{% if kindFilter %}&kind={{ kindFilter|url_encode }}{% endif %}{% if q %}&q={{ q|url_encode }}{% endif %}">
								<span class="admin-ingest-pipeline__count">{{ stage.count }}</span>
								<span class="admin-ingest-pipeline__label">{{ stage.label }}</span>
							</a>
						</li>
					{% endfor %}
				</ol>
				<div class="admin-ingest-pipeline__meta">
					<p>
						Celkem <strong>{{ pipeline.total }}</strong>
						· prompt <code>{{ enrichmentVersion }}</code>
						{% if pipeline.stale %}
							· <a href="{{ url("admin.ingest.index") }}?status=stale{% if sourceFilter %}&source={{ sourceFilter }}{% endif %}{% if accountFilter %}&account={{ accountFilter }}{% endif %}{% if kindFilter %}&kind={{ kindFilter|url_encode }}{% endif %}{% if q %}&q={{ q|url_encode }}{% endif %}"><strong>{{ pipeline.stale }}</strong> zastaralých LLM</a>
						{% endif %}
						{% if pipeline.skipped %}
							· {{ pipeline.skipped }} přeskočeno
						{% endif %}
					</p>
					{% if pipeline.bySource %}
						<p class="admin-ingest-pipeline__sources">
							{% for source, count in pipeline.bySource %}
								<span>{{ source }} {{ count }}</span>
							{% endfor %}
						</p>
					{% endif %}
				</div>
			</div>
		</section>

		{% if kinds %}
			<section class="admin-section">
				<h2 class="admin-section__title">Druh (kind)</h2>
				<div class="admin-ingest-facets">
					{% for row in kinds %}
						<a class="admin-button admin-button--ghost{% if kindFilter == row.kind %} is-active{% endif %}" href="{{ url("admin.ingest.index") }}?kind={{ row.kind|url_encode }}{% if statusFilter %}&status={{ statusFilter }}{% endif %}{% if sourceFilter %}&source={{ sourceFilter }}{% endif %}{% if accountFilter %}&account={{ accountFilter }}{% endif %}{% if q %}&q={{ q|url_encode }}{% endif %}">{{ row.kind }} <span class="admin-muted">{{ row.count }}</span></a>
					{% endfor %}
				</div>
			</section>
		{% endif %}

		<p class="admin-page__lede">
			{% if pagination.total %}
				Zobrazeno {{ pagination.from }}–{{ pagination.to }} z {{ pagination.total }}
			{% else %}
				Zobrazeno 0
			{% endif %}
			{% if statusFilter %}· filtr stavu <code>{{ statusFilter }}</code>{% endif %}
			{% if sourceFilter %}· zdroj <code>{{ sourceFilter }}</code>{% endif %}
			{% if accountFilter %}· účet <code>@{{ accountFilter }}</code>{% endif %}
			{% if kindFilter %}· druh <code>{{ kindFilter }}</code>{% endif %}
			{% if q %}· hledání <code>{{ q }}</code>{% endif %}
		</p>

		<div class="admin-panel admin-panel--scroll">
			<table class="admin-table admin-table--ingest">
				<thead>
					<tr>
						<th class="admin-table__id">ID</th>
						<th>Náhled</th>
						<th>Název</th>
						<th>Zdroj</th>
						<th>Datum</th>
						<th>Druh</th>
						<th>Stav</th>
						<th>LLM</th>
						<th class="admin-table__num">Fotky</th>
					</tr>
				</thead>
				<tbody>
					{% for row in rows %}
						{% set item = row.item %}
						<tr>
							<td class="admin-table__id">{{ item.getId }}</td>
							<td class="admin-table__thumb">
								{% if item.getHeroImage %}
									<a href="{{ url("admin.ingest.view", { ingestItemId: item.getId }) }}">
										<img class="admin-thumbnail" src="{{ item.getHeroImage.getImageVersion("THUMBNAIL").getURL }}" alt="">
									</a>
								{% endif %}
							</td>
							<td class="admin-table__title">
								<a href="{{ url("admin.ingest.view", { ingestItemId: item.getId }) }}">{{ item.getTitle|default("—") }}</a>
							</td>
							<td class="admin-table__nowrap">{{ item.getSourceLabel }}</td>
							<td class="admin-table__nowrap">{% if item.getPostedAt %}{{ item.getPostedAt|date("j. n. Y") }}{% else %}—{% endif %}</td>
							<td class="admin-table__nowrap">{% if row.kind %}<code>{{ row.kind }}</code>{% else %}<span class="admin-muted">—</span>{% endif %}</td>
							<td>
								<span class="admin-ingest-badge admin-ingest-badge--status-{{ item.getStatus }}">{{ item.getStatusBadgeLabel }}</span>
							</td>
							<td class="admin-ingest-llm-cell">
								{% if item.getStatus == "keyworded" or item.getStatus == "categorized" or item.getStatus == "materialized" %}
									{% if row.isStale %}
										<span class="admin-ingest-badge admin-ingest-badge--stale">{{ row.enrichmentVersion|default("—") }} stale</span>
									{% elseif row.enrichmentVersion %}
										<span class="admin-ingest-badge">{{ row.enrichmentVersion }}</span>
									{% endif %}
									{% if row.hasCover %}<span class="admin-ingest-badge admin-ingest-badge--cover">cover</span>{% endif %}
									{% if row.keywordCount %}<span class="admin-ingest-badge">{{ row.keywordCount }} kw</span>{% endif %}
								{% else %}
									<span class="admin-muted">—</span>
								{% endif %}
							</td>
							<td class="admin-table__num">{{ item.getFileCount }}</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="9">Žádné položky pro tento filtr.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		{% if pagination.totalPages > 1 %}
			<nav class="admin-pagination" aria-label="Stránkování">
				{% if pagination.hasPrev %}
					<a class="admin-button admin-button--ghost" href="{{ url("admin.ingest.index") }}?{{ fq }}page={{ pagination.prevPage }}">Předchozí</a>
				{% else %}
					<span class="admin-button admin-button--ghost is-disabled">Předchozí</span>
				{% endif %}

				<ol class="admin-pagination__pages">
					{% for p in pagination.pages %}
						{% if p is null %}
							<li class="admin-pagination__gap" aria-hidden="true">…</li>
						{% elseif p == pagination.page %}
							<li><span class="admin-button is-active" aria-current="page">{{ p }}</span></li>
						{% else %}
							<li><a class="admin-button admin-button--ghost" href="{{ url("admin.ingest.index") }}?{{ fq }}page={{ p }}">{{ p }}</a></li>
						{% endif %}
					{% endfor %}
				</ol>

				{% if pagination.hasNext %}
					<a class="admin-button admin-button--ghost" href="{{ url("admin.ingest.index") }}?{{ fq }}page={{ pagination.nextPage }}">Další</a>
				{% else %}
					<span class="admin-button admin-button--ghost is-disabled">Další</span>
				{% endif %}
			</nav>
		{% endif %}
	</div>

{% endblock body %}
