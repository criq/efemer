{% extends "Templates/default.twig" %}

{% block title %}{{ post.getTitle }} · Efemér{% endblock %}

{% block bodyClass %}site--invitation{% endblock %}

{% block body %}

	<article class="invite" id="invite-body">
		<header class="invite__header" data-reveal>
			<p class="text-eyebrow"><a href="{{ sectionPath }}">{{ sectionTitle|lower }}</a></p>
			<span class="invite__kicker">{{ post.getInviteKicker }}</span>
			<h1 class="invite__title">{{ post.getTitle }}</h1>
			{% if post.getPlace or post.getDateLabel %}
				<p class="invite__meta">
					{% if post.getPlace %}<span class="invite__place">{{ post.getPlace }}</span>{% endif %}
					{% if post.getPlace and post.getDateLabel %}<span class="invite__dot"> · </span>{% endif %}
					{% if post.getDateLabel %}
						<span class="invite__when">
							{{ post.getDateLabel }}{% if post.getTimeLabel %} · {{ post.getTimeLabel }}{% endif %}
						</span>
					{% endif %}
				</p>
			{% endif %}
			{% if post.getInstagramShortcode %}
				<p class="invite__actions">
					<a class="invite__cta" href="https://www.instagram.com/p/{{ post.getInstagramShortcode }}/" target="_blank" rel="noopener noreferrer">Připoj se</a>
				</p>
			{% endif %}
		</header>

		{% include "Posts/parts.twig" with { parts: post.getResolvedParts } %}

		{% if post.getInstagramShortcode %}
			<p class="invite__out" data-reveal>
				<a href="https://www.instagram.com/p/{{ post.getInstagramShortcode }}/" target="_blank" rel="noopener noreferrer">na Instagramu</a>
			</p>
		{% endif %}
	</article>

{% endblock body %}
