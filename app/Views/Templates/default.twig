<!DOCTYPE html>
<html lang="cs">
	<head>

		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% block title %}Efemér{% endblock %}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Outfit:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;1,8..60,400&display=swap">
		<link rel="stylesheet" href="/css/main.css">
		{% block head %}{% endblock %}

	</head>
	<body class="{% block bodyClass %}{% endblock %}">

		<div class="site">
			<header class="site-header">
				<div class="site-header__inner">
					<a class="site-brand" href="{{ url("homepage.index") }}" aria-label="Efemér">
						<img class="site-brand__logo" src="/img/logo.png" alt="Efemér">
					</a>
					<button class="site-nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Otevřít menu">
						<span class="site-nav-toggle__bars" aria-hidden="true"></span>
					</button>
					<nav class="site-nav" id="site-nav" aria-label="Hlavní menu">
						<ul>
							<li><a href="{{ url("sections.ritualy") }}">rituály</a></li>
							<li><a href="{{ url("sections.denik") }}">deník</a></li>
							<li><a href="{{ url("sections.umeni") }}">umění</a></li>
							<li><a href="{{ url("site.kontakt") }}">kontakt</a></li>
						</ul>
					</nav>
				</div>
			</header>

			<main class="site-main">
				{% block body %}
				{% endblock body %}
			</main>

			<footer class="site-footer">
				<p class="site-footer__claim">květiny · rituály · krajina · dům</p>
				<p class="site-footer__contact">
					<a href="{{ url("site.kontakt") }}">kontakt</a>
					<span aria-hidden="true">·</span>
					<a href="{{ url("site.vTisku") }}">v tisku</a>
					<span aria-hidden="true">·</span>
					<a href="{{ url("site.newsletter") }}">newsletter</a>
				</p>
			</footer>
		</div>

		<script src="/javascript/app.js"></script>

	</body>
</html>
