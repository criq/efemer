{% extends "Templates/default.twig" %}

{% block title %}{{ page.getTitle|default("Efemér") }}{% endblock %}

{% block bodyClass %}{% if page.getPath == "/" %}site--index{% else %}site--page{% endif %}{% endblock %}

{% block body %}

	{% for pageComponent in page.getRootPageComponents %}
		<section class="page-component{% if page.getPath == "/" and loop.first %} site-hero{% elseif page.getPath != "/" and loop.first %} page-header{% endif %}" data-reveal>
			{% include "Pages/Components/view.twig" with { pageComponent: pageComponent } %}
		</section>
	{% endfor %}

{% endblock body %}
