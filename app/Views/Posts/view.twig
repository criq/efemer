{% extends "Templates/default.twig" %}

{% block title %}{{ post.getTitle }} · Efemér{% endblock %}

{% block bodyClass %}site--post{% endblock %}

{% block body %}

	<article class="post-page">
		<header class="post-page__header" data-reveal>
			<p class="text-eyebrow"><a href="{{ sectionPath }}">{{ sectionTitle|lower }}</a></p>
			<h1>{{ post.getTitle }}</h1>
			{% if post.getPublishedAt %}
				<p class="post-page__date">{{ post.getPublishedAt|date("j. n. Y") }}</p>
			{% endif %}
		</header>

		{% set files = post.getFiles %}
		{% if files.getFirst %}
			<figure class="post-page__hero" data-reveal>
				<img src="{{ files.getFirst.getImage.getImageVersion("GALLERY").getURL }}" alt="{{ files.getFirst.getCaption }}">
			</figure>
		{% endif %}

		{% if post.getBodyHtml %}
			<div class="post-page__body" data-reveal>
				{{ post.getBodyHtml|raw }}
			</div>
		{% endif %}

		{% if files|length > 1 %}
			<ul class="post-page__gallery">
				{% for file in files %}
					{% if not loop.first and file.getImage %}
						<li class="post-page__frame post-page__frame--{{ loop.index0 % 3 }}">
							<img src="{{ file.getImage.getImageVersion("GALLERY").getURL }}" alt="{{ file.getCaption }}">
							{% if file.getCaption %}
								<figcaption>{{ file.getCaption }}</figcaption>
							{% endif %}
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		{% endif %}
	</article>

{% endblock body %}
