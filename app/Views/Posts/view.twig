{% extends "Templates/default.twig" %}

{% block title %}{{ post.getTitle }} · Efemér{% endblock %}

{% block bodyClass %}site--post{% endblock %}

{% block body %}

	<article class="post-page">
		<header class="post-page__header" data-reveal>
			<p class="text-eyebrow"><a href="{{ sectionPath }}">{{ sectionTitle|lower }}</a></p>
			<h1>{{ post.getTitle }}</h1>
			{% if post.getPublishedAt %}
				<p class="post-page__date">{{ post.getPublishedAt|date("j. n. Y") }}</p>
			{% endif %}
		</header>

		{% include "Posts/parts.twig" with { parts: post.getResolvedParts } %}
	</article>

{% endblock body %}
