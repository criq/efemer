{% extends "Templates/default.twig" %}

{% block title %}{{ post.getTitle }} · Efemér{% endblock %}

{% block bodyClass %}site--post {{ sectionBodyClass|default("site--denik") }}{% endblock %}

{% block body %}

	{% set shell = feedClass|default("denik") %}
	{% set itemShell = shell ~ "-feed__item" %}
	{% set articleShell = shell ~ "-feed__article" %}

	<div class="{{ shell }}">
		<div
			class="{{ shell }}__feed"
			data-feed
			{% if feedHasMore and feedNextUrl %}data-feed-next="{{ feedNextUrl }}"{% endif %}
		>
			<article
				class="{{ itemShell }}"
				id="post-{{ post.getId }}"
				data-feed-url="{{ post.getPublicPath }}"
				data-feed-title="{{ post.getTitle|e("html_attr") }} · Efemér"
			>
				<div class="post-article {{ articleShell }}">
					{% include "Posts/body.twig" with {
						post: post,
						sectionPath: sectionPath,
						sectionTitle: sectionTitle,
						linkedTitle: false,
						showSectionEyebrow: true,
						headingTag: "h1",
					} %}
				</div>
			</article>

			{% for continuePost in continuePosts|default([]) %}
				{% include itemTemplate with { post: continuePost } %}
			{% endfor %}
			{% include "Partials/feed-ritualy-banner-slot.twig" with {
				posts: continuePosts|default([]),
				showRitualyBanner: showRitualyBanner|default(false),
				ritualyBannerImages: ritualyBannerImages|default([]),
				feedPageSize: feedPageSize|default(4),
			} %}

			{% if feedHasMore %}
				<div class="feed-sentinel" data-feed-sentinel aria-hidden="true"></div>
			{% endif %}
		</div>
	</div>

{% endblock body %}
