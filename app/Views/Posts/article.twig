{% extends "Templates/default.twig" %}

{% block title %}{{ post.getTitle }} · Efemér{% endblock %}

{% block bodyClass %}site--post{% endblock %}

{% block body %}

	<article class="post-article" id="post-body">
		{% include "Posts/body.twig" with {
			post: post,
			sectionPath: sectionPath,
			sectionTitle: sectionTitle,
			linkedTitle: false,
			showSectionEyebrow: true,
			headingTag: "h1",
		} %}
	</article>

{% endblock body %}
