{
  "name": "efemer/efemer",
  "require": {
    "php": ">=8.4",
    "criq/katu": "^8",
    "criq/sexy": "^8",
    "google/cloud": "@stable",
    "nyholm/psr7": "^1.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "./app/"
    }
  },
  "scripts": {
    "post-create-project-cmd": [
      "npm install"
    ],
    "migrate": "php bin/migrate.php"
  },
  "config": {
    "platform": {
      "php": "8.4.0"
    },
    "audit": {
      "block-insecure": false
    }
  }
}
